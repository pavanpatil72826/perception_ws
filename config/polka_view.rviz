Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Merged cloud1
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 20
      Color: 100; 100; 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Merged cloud
      Enabled: true
      Topic:
        Value: /polka/merged_cloud
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: true
      Position Transformer: XYZ
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw front (flat green)
      Enabled: false
      Topic:
        Value: /drwig_Front_licam/points
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Position Transformer: XYZ
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw rear (flat red)
      Enabled: false
      Topic:
        Value: /drwig_Rear_licam/points
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Position Transformer: XYZ
      Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: imu_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 45
      Pitch: 1.2
      Yaw: 3.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1600
